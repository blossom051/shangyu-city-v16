class_name PlayerCompany
extends RefCounted

static func create(player_id: String, seat: int, company: Dictionary, human: bool) -> Dictionary:
	return {
		"id": player_id, 
		"seat": seat, 
		"human": human, 
		"company_id": str(company.id), 
		"name": str(company.name), 
		"color": str(company.color), 
		"cash": int(company.capital), 
		"debt": 0, 
		"risk": 0, 
		"risk_history": [], 
		"land_ids": [], 
		"business_ids": [], 
		"talent_ids": [], 
		"hand": [], 
		"stocks": {}, 
		"listed_stocks": {}, 
		"loans": [], 
		"active_projects": [], 
		"enterprise_valuation": 0, 
		"investment_track_record": 0, 
		"investment_experience": 0, 
		"next_project_bonus": 0.0, 
		"effects": [], 
		"guards": [], 
		"secret_zone": [], 
		"continuous_zone": [], 
		"strategy_points": 3, 
		"strategy_points_max": 3, 
		"discard": [], 
		"red_points": 0, 
		"pending_card_reward": {}, 
		"card_points": 0, 
		"card_draws_since_platinum": 0, 
		"card_draws_since_red": 0, 
		"district_influence": {}, 
		"round_history": [], 
		"cash_crisis": false, 
		"credit_frozen_rounds": 0, 
		"missed_payments": 0, 
		"status": "active", 
		"eliminated": false, 
		"last_interest_paid": 0, 
		"last_loan_settlement": {}, 
		"consecutive_no_land": 0, 
		"actions": {"land": 0, "build": 0, "card": 0, "attack_card": 0}, 
		"round_net": 0, 
		"rank": seat + 1, 
		"asset_value": int(company.capital), 
		"abilities": company.get("abilities", {}), 
		"ability_state": {}, 
	}
